# Reviewed, reproducible PHP/native runtime. Dependency pins are updated through PRs.
FROM php:8.6.0RC2-apache-trixie@sha256:aa7d5b43deb4a1af6b9695f35f4395b6fb4314ee8d2ed437c9ab5f552f2de770 AS runtime-base
COPY docker/verify-php-version.php /usr/local/bin/verify-kmp-php-version.php
RUN php /usr/local/bin/verify-kmp-php-version.php
COPY --from=mlocati/php-extension-installer:latest@sha256:b6d3fa381b9ba5cf051117c1c601d6a523b590e534bf3d56eb4fbe352949c138 /usr/bin/install-php-extensions /usr/local/bin/
COPY docker/install-runtime.sh /usr/local/bin/install-kmp-runtime
ARG PHP_BUILD_JOBS=4
RUN IPE_PROCESSOR_COUNT="${PHP_BUILD_JOBS}" sh /usr/local/bin/install-kmp-runtime

LABEL org.opencontainers.image.source="https://github.com/Ansteorra/KMP"
EXPOSE 80
